# Snakefile — SOD1 FEP variant pipeline DAG
# Historical simulation rules plus the current CPU-only forensic release.
# Design intent lives in README.md; parameters live in config/pipeline.yaml.
#
# The DAG:
#   panel -> prep -> prescreen -> fep -> validate  (gate) -> classify
#                                    \-> md (mechanism, flagged subset)
#
# Stage 3 (fep) is the fan-out: one job per (variant, leg, window, replicate).
# Scheduler is SGE/OGS on the BU SCC: Stage 3 dispatches via scripts/submit_array.sh
# (qsub -t array); this Snakefile stays the DAG / dependency source of truth.

configfile: "config/pipeline.yaml"

import csv, json, os, yaml
from pathlib import Path

# ---- Load the panel to build wildcards -------------------------------------
# variants.csv is the source of truth (Stage 0 output).
def load_variants():
    path = config["panel"]["csv"]
    if not os.path.exists(path):
        return []
    with open(path) as f:
        return [row["variant"] for row in csv.DictReader(f)]

VARIANTS   = load_variants()
LEGS       = config["fep"]["legs"]
WINDOWS    = list(range(config["fep"]["lambda_windows"]))
REPLICATES = list(range(config["fep"]["replicates"]))
# rule all targets the validation gate, not the whole panel: only
# validation.gate_subset (charge-neutral controls) is FEP-runnable today, and the
# prescreen backend does not exist. GATE_SUBSET is what the gate needs as inputs.
GATE_SUBSET = config["validation"]["gate_subset"]
GATE_REPORT = config["validation"]["outputs"]["gate_report"]


def gate_dependency(wildcards):
    """Make every non-gate FEP task wait for the control validation barrier."""
    return [] if wildcards.variant in GATE_SUBSET else GATE_REPORT


# ---- Target rule -----------------------------------------------------------
rule all:
    input:
        config['forensic_review']['release_file'],


# ---- Stage 0: build & stratify the variant panel ---------------------------
rule panel:
    output:
        config["panel"]["csv"],
    shell:
        # TODO: pull ClinVar + ALSoD, cross-ref gnomAD, stratify into buckets,
        #       enforce mature-numbering offset, fail if no positive controls.
        "python -m src.panel.build --config config/pipeline.yaml --out {output}"


# ---- Stage 1: prepare structure (apo) --------------------------------------
rule prep:
    input:
        panel=config["panel"]["csv"],
    output:
        "data/structures/{variant}.pdb",
    shell:
        # TODO: apply mutation, apo + reduced disulfide, protonate, solvate, ionize.
        "python -m src.prep.build --variant {wildcards.variant} "
        "--config config/pipeline.yaml --out {output}"


# ---- Stage 2: cheap empirical prescreen (CPU, all variants) ----------------
rule prescreen:
    input:
        struct="data/structures/{variant}.pdb",
    output:
        "results/prescreen/{variant}.json",
    shell:
        # TODO: FoldX BuildModel + Rosetta cartesian_ddg; emit ddG estimate.
        "python -m src.prescreen.run --variant {wildcards.variant} "
        "--config config/pipeline.yaml --out {output}"


# ---- Stage 3: alchemical FEP window (the SGE array unit) --------------------
# One invocation == one (variant, leg, window, replicate). Submit as an SGE array
# (qsub -t) via scripts/submit_array.sh. Use the scheduler-assigned
# CUDA_VISIBLE_DEVICES as-is inside src.fep.window -- never hardcode a device id.
rule fep_window:
    input:
        struct="data/structures/{variant}.pdb",
        gate=gate_dependency,
    output:
        "results/fep/{variant}/{leg}/w{window}_r{rep}.npz",
    resources:
        gpu=1,
    shell:
        # TODO: dispatch to chosen framework (openmm_perses|gromacs_pmx|amber_ti).
        "python -m src.fep.window --variant {wildcards.variant} "
        "--leg {wildcards.leg} --window {wildcards.window} --rep {wildcards.rep} "
        "--config config/pipeline.yaml --out {output}"


# ---- Stage 3 (cont.): collect windows -> per-variant ddG via MBAR ----------
rule fep_ddg:
    input:
        lambda wc: [
            f"results/fep/{wc.variant}/{leg}/w{w}_r{r}.npz"
            for leg in LEGS for w in WINDOWS for r in REPLICATES
        ],
        gate=gate_dependency,
    output:
        "results/fep/{variant}/ddg.json",
    shell:
        # TODO: MBAR over both legs, cycle-closure + hysteresis checks.
        "python -m src.fep.analyze --variant {wildcards.variant} "
        "--config config/pipeline.yaml --out {output}"


# ---- Isolated post-gate pilot: exact-path F64A folded continuation ----------
# The stage manifests are explicit external inputs because creating them copies and
# validates a frozen archive. GPU execution remains an SGE array, matching Stage 3's
# scheduler contract; these rules record the dependency graph and support targeted
# Snakemake execution without adding the pilot to the default forensic-release target.
F64A_PILOT_CONFIG = 'pilots/f64a_sampling_extension_v1/config.yaml'
F64A_PILOT = yaml.safe_load(Path(F64A_PILOT_CONFIG).read_text())
F64A_PILOT_ROOT = F64A_PILOT['output_root']
F64A_PILOT_WINDOWS = list(range(F64A_PILOT['lambda_windows']))
F64A_PILOT_REPLICATES = list(range(F64A_PILOT['replicates']))

rule f64a_extension_first_light:
    input:
        stage=F64A_PILOT_ROOT + '/first_light/stage_manifest.json',
        code='src/fep/f64a_extension.py',
        config=F64A_PILOT_CONFIG,
    output:
        F64A_PILOT_ROOT + '/first_light/fep/F64A/folded/w0_r0.npz',
    resources:
        gpu=1,
    shell:
        'python -m src.fep.f64a_extension --config {input.config:q} '
        'run --window 0 --rep 0 --first-light'


rule f64a_extension_window:
    input:
        stage=F64A_PILOT_ROOT + '/production/stage_manifest.json',
        first_light=rules.f64a_extension_first_light.output,
        code='src/fep/f64a_extension.py',
        config=F64A_PILOT_CONFIG,
    output:
        F64A_PILOT_ROOT + '/production/fep/F64A/folded/w{window}_r{rep}.npz',
    resources:
        gpu=1,
    shell:
        'python -m src.fep.f64a_extension --config {input.config:q} '
        'run --window {wildcards.window} --rep {wildcards.rep}'


rule f64a_extension_analysis:
    input:
        windows=expand(
            F64A_PILOT_ROOT + '/production/fep/F64A/folded/w{window}_r{rep}.npz',
            window=F64A_PILOT_WINDOWS, rep=F64A_PILOT_REPLICATES,
        ),
        code='src/fep/f64a_extension.py',
        analyzer='src/fep/analyze.py',
        config=F64A_PILOT_CONFIG,
        prereg='pilots/f64a_sampling_extension_v1/PREREGISTRATION.md',
    output:
        F64A_PILOT_ROOT + '/production/analysis/f64a_extension.json',
    shell:
        'python -m src.fep.f64a_extension --config {input.config:q} analyze'


# CPU post-pilot analysis must consume completed GPU outputs, never schedule missing
# ones. Use --allowed-rules f64a_extension_blocks to exclude all GPU producers.
F64A_BLOCK_CONFIG = 'pilots/f64a_sampling_extension_v1/cpu_blocks.yaml'
F64A_BLOCK_DESIGN = yaml.safe_load(Path(F64A_BLOCK_CONFIG).read_text())

def completed_f64a_block_inputs(wildcards):
    paths = [
        F64A_PILOT_ROOT + '/production/stage_manifest.json',
        F64A_PILOT_ROOT + '/production/analysis/f64a_extension.json',
    ] + expand(
        F64A_PILOT_ROOT + '/production/fep/F64A/folded/w{window}_r{rep}.npz',
        window=F64A_PILOT_WINDOWS, rep=F64A_PILOT_REPLICATES,
    )
    missing = [path for path in paths if not Path(path).is_file()]
    if missing:
        raise FileNotFoundError('CPU blocks require completed pilot inputs; '
                                'will not schedule GPU work: ' + missing[0])
    return ancient(paths)

localrules: f64a_extension_blocks

rule f64a_extension_blocks:
    input:
        completed=completed_f64a_block_inputs,
        code='src/analysis/f64a_blocks.py',
        estimator='src/fep/analyze.py',
        validator='src/fep/f64a_extension.py',
        config=F64A_BLOCK_CONFIG,
        reference=F64A_BLOCK_DESIGN['reference_report'],
        design='docs/f64a_block_analysis_design.md',
    output:
        F64A_PILOT_ROOT + '/production/analysis/' + F64A_BLOCK_DESIGN['output_name'],
    resources:
        gpu=0,
    shell:
        'python -m src.analysis.f64a_blocks --config {input.config:q}'


F64A_SENSITIVITY_CONFIG = 'pilots/f64a_sampling_extension_v1/cpu_sensitivity.yaml'
F64A_SENSITIVITY_DESIGN = yaml.safe_load(Path(F64A_SENSITIVITY_CONFIG).read_text())

def completed_f64a_sensitivity_inputs(wildcards):
    paths = list(completed_f64a_block_inputs(wildcards))
    block_report = F64A_PILOT_ROOT + '/production/analysis/f64a_blocks_v1.json'
    if not Path(block_report).is_file():
        raise FileNotFoundError('CPU sensitivity requires completed block report; '
                                'will not schedule GPU work: ' + block_report)
    return ancient(paths + [block_report])

localrules: f64a_extension_sensitivity

rule f64a_extension_sensitivity:
    input:
        completed=completed_f64a_sensitivity_inputs,
        code='src/analysis/f64a_sensitivity.py',
        blocks='src/analysis/f64a_blocks.py',
        estimator='src/fep/analyze.py',
        validator='src/fep/f64a_extension.py',
        config=F64A_SENSITIVITY_CONFIG,
        reference=F64A_SENSITIVITY_DESIGN['reference_report'],
        block_reference=F64A_SENSITIVITY_DESIGN['block_reference'],
        design='docs/f64a_selection_sensitivity_design.md',
    output:
        F64A_PILOT_ROOT + '/production/analysis/' + F64A_SENSITIVITY_DESIGN['output_name'],
    resources:
        gpu=0,
    shell:
        'python -m src.analysis.f64a_sensitivity --config {input.config:q}'


# ---- Authorized v2 continuation: never alter completed v1 -----------------
F64A_V2_CONFIG = 'pilots/f64a_sampling_extension_v2/config.yaml'
F64A_V2 = yaml.safe_load(Path(F64A_V2_CONFIG).read_text())
F64A_V2_ROOT = F64A_V2['output_root']

def completed_f64a_v2_sources(wildcards):
    # Source inventories/approvals are created by explicit preflight, never a
    # producer that can silently rerun the historical simulation.
    admission = F64A_V2_ROOT + '/admission.json'
    if not Path(admission).is_file():
        raise FileNotFoundError('v2 needs explicit resource admission: ' + admission)
    files = json.loads(Path(admission).read_text())['source_inventory']['files']
    missing = [e['source'] for e in files if not Path(e['source']).is_file()]
    if missing:
        raise FileNotFoundError('v2 requires completed sources; will not schedule GPU work: ' + missing[0])
    return ancient([admission] + [e['source'] for e in files])

localrules: f64a_v2_stage_light, f64a_v2_stage_production, f64a_v2_analysis

rule f64a_v2_stage_light:
    input:
        sources=completed_f64a_v2_sources,
        config=F64A_V2_CONFIG,
        code='src/fep/f64a_continuation.py',
    output:
        F64A_V2_ROOT + '/first_light/stage_manifest.json',
    shell:
        'python -m src.fep.f64a_continuation --config {input.config:q} stage --first-light'

rule f64a_v2_first_light:
    input:
        stage=rules.f64a_v2_stage_light.output,
        config=F64A_V2_CONFIG,
        code='src/fep/f64a_continuation.py',
    output:
        F64A_V2_ROOT + '/first_light/fep/F64A/folded/w0_r0.npz',
    resources:
        gpu=1,
    shell:
        'python -m src.fep.f64a_continuation --config {input.config:q} '
        'run --window 0 --rep 0 --first-light'

rule f64a_v2_stage_production:
    input:
        sources=completed_f64a_v2_sources,
        first_light=rules.f64a_v2_first_light.output,
        config=F64A_V2_CONFIG,
        code='src/fep/f64a_continuation.py',
    output:
        F64A_V2_ROOT + '/production/stage_manifest.json',
    shell:
        'python -m src.fep.f64a_continuation --config {input.config:q} stage'

rule f64a_v2_window:
    input:
        stage=rules.f64a_v2_stage_production.output,
        first_light=rules.f64a_v2_first_light.output,
        config=F64A_V2_CONFIG,
        code='src/fep/f64a_continuation.py',
    output:
        F64A_V2_ROOT + '/production/fep/F64A/folded/w{window}_r{rep}.npz',
    wildcard_constraints:
        window='(?:[0-9]|1[0-9])', rep='[0-2]',
    resources:
        gpu=1,
    shell:
        'python -m src.fep.f64a_continuation --config {input.config:q} '
        'run --window {wildcards.window} --rep {wildcards.rep}'

def completed_f64a_v2_outputs(wildcards):
    paths = [F64A_V2_ROOT + '/admission.json', F64A_V2_ROOT + '/production/stage_manifest.json'] + expand(
        F64A_V2_ROOT + '/production/fep/F64A/folded/w{window}_r{rep}.npz',
        window=range(F64A_V2['lambda_windows']), rep=range(F64A_V2['replicates']))
    missing = [p for p in paths if not Path(p).is_file()]
    if missing:
        raise FileNotFoundError('v2 CPU analysis needs completed outputs; will not schedule GPU work: ' + missing[0])
    return ancient(paths)

rule f64a_v2_analysis:
    input:
        completed=completed_f64a_v2_outputs,
        config=F64A_V2_CONFIG,
        design='pilots/f64a_sampling_extension_v2/PREREGISTRATION.md',
        analysis_config=F64A_V2['analysis_config'],
        code='src/analysis/f64a_continuation.py',
        simulation='src/fep/f64a_continuation.py',
        blocks='src/analysis/f64a_blocks.py',
        sensitivity='src/analysis/f64a_sensitivity.py',
        estimator='src/fep/analyze.py',
        reference=F64A_V2['reference_primary'],
    output:
        F64A_V2_ROOT + '/production/analysis/f64a_continuation_v2.json',
    resources:
        gpu=0,
    shell:
        'python -m src.analysis.f64a_continuation --config {input.config:q}'


# ---- Stage 4: unbiased mechanism MD (flagged subset only) ------------------
rule md_mechanism:
    input:
        struct="data/structures/{variant}.pdb",
    output:
        "results/md/{variant}/analysis.json",
    resources:
        gpu=1,
    shell:
        # TODO: replicate plain MD; rmsf/contacts/salt-bridges/sasa/interface.
        "python -m src.md.run --variant {wildcards.variant} "
        "--config config/pipeline.yaml --out {output}"


# ---- Stage 5a: validation GATE ----------------------------------------------
# This is the explicit barrier: only the configured control subset is needed, and
# non-gate FEP tasks depend on its report through gate_dependency above.
rule validate_gate:
    input:
        [f"results/fep/{v}/ddg.json" for v in GATE_SUBSET],
    output:
        GATE_REPORT,
    shell:
        "python -m src.analysis.validate --gate-only --config config/pipeline.yaml "
        "--out {output}"


# ---- Stage 5b: validation + classification ---------------------------------
# Aggregates all per-variant ddG, checks controls, THEN classifies novel variants.
rule validate:
    input:
        fep=[f"results/fep/{v}/ddg.json" for v in VARIANTS],
        prescreen=[f"results/prescreen/{v}.json" for v in VARIANTS],
        gate=GATE_REPORT,
    output:
        config["validation"]["outputs"]["ddg_map"],
    shell:
        # TODO: correlate FEP vs experimental controls; enforce min_pearson gate;
        #       cross-check vs prescreen; classify uncharacterized variants.
        "python -m src.analysis.validate --config config/pipeline.yaml "
        "--out {output}"

# ---- Current project: forensic analysis only, no GPU dependencies ---------
REVIEW = config['forensic_review']
ARCHIVE = REVIEW['main_archive']
SS_ARCHIVE = REVIEW['ss_archive']
REVIEW_DIR = REVIEW['output_dir']
TEMPORAL = REVIEW['temporal']
TEMPORAL_DIR = TEMPORAL['output_dir']
TEMPORAL_OUTPUTS = TEMPORAL['outputs']
HISTORICAL_ROOTS = {'main_archive': ARCHIVE, 'ss_archive': SS_ARCHIVE,
                    'repository': 'data/forensic_baseline_repository'}
HISTORICAL_INPUTS = [
    str(Path(HISTORICAL_ROOTS[entry['root']]) / entry['path'])
    for entry in json.loads(Path('data/forensic_archive_manifest.json').read_text())['files']
]

rule forensic_diagnostic_audit:
    input:
        windows=expand(ARCHIVE + '/fep/{variant}/{leg}/w{window}_r{rep}.npz',
                       variant=GATE_SUBSET, leg=LEGS, window=WINDOWS, rep=REPLICATES),
        records=expand(ARCHIVE + '/convergence/{variant}.json', variant=GATE_SUBSET),
        code='src/analysis/diagnostic_audit.py',
        analyzer='src/fep/analyze.py',
        config='config/pipeline.yaml',
        panel=config['panel']['csv'],
    output:
        report=REVIEW_DIR + '/diagnostic_audit.json',
        records=REVIEW_DIR + '/diagnostic_records.csv',
        adjacent=REVIEW_DIR + '/adjacent_discrepancies.csv',
        figure=REVIEW_DIR + '/diagnostic_cancellation.png',
    shell:
        'MPLCONFIGDIR=/tmp/sod1fep-mpl python -m src.analysis.diagnostic_audit '
        '--archive-root {ARCHIVE:q} --output-dir {REVIEW_DIR:q}'


rule temporal_diagnostic_audit:
    input:
        windows=expand(ARCHIVE + '/fep/{variant}/{leg}/w{window}_r{rep}.npz',
                       variant=GATE_SUBSET, leg=LEGS, window=WINDOWS, rep=REPLICATES),
        records=expand(ARCHIVE + '/convergence/{variant}.json', variant=GATE_SUBSET),
        code='src/analysis/diagnostic_audit.py',
        analyzer='src/fep/analyze.py',
        design='docs/temporal_analysis_design.md',
        config='config/pipeline.yaml',
        panel=config['panel']['csv'],
    output:
        report=TEMPORAL_DIR + '/' + TEMPORAL_OUTPUTS['report'],
        legs=TEMPORAL_DIR + '/' + TEMPORAL_OUTPUTS['leg_records'],
        ddg=TEMPORAL_DIR + '/' + TEMPORAL_OUTPUTS['ddg_records'],
        adjacent=TEMPORAL_DIR + '/' + TEMPORAL_OUTPUTS['adjacent_records'],
        trajectories=TEMPORAL_DIR + '/' + TEMPORAL_OUTPUTS['trajectories_figure'],
        local=TEMPORAL_DIR + '/' + TEMPORAL_OUTPUTS['local_figure'],
    shell:
        'MPLCONFIGDIR=/tmp/sod1fep-mpl python -m src.analysis.diagnostic_audit '
        '--temporal --archive-root {ARCHIVE:q} --output-dir {TEMPORAL_DIR:q}'

rule forensic_methods_figures:
    input:
        records=expand(ARCHIVE + '/reanalysis_2026-09-12/convergence/{variant}.json', variant=GATE_SUBSET),
        gate=expand(ARCHIVE + '/fep/{variant}/ddg.json', variant=[v for v in GATE_SUBSET if v != 'A4V']),
        a4v_gate=ARCHIVE + '/archive/A4V_3ns_ddg.json',
        a4v_3ns=ARCHIVE + '/archive/A4V_3ns_convergence.json',
        a4v_9ns=ARCHIVE + '/convergence/A4V.json',
        ss=SS_ARCHIVE + '/convergence_SS.json',
        tops2sh=expand(ARCHIVE + '/fep/G93A/folded/system_r{rep}/hybrid.top', rep=REPLICATES),
        topsss=expand(SS_ARCHIVE + '/folded/system_r{rep}/hybrid.top', rep=REPLICATES),
        code='src/analysis/methods_figures.py',
        sensitivity='src/analysis/reference_sensitivity.py',
        validation='src/analysis/validate.py',
        config='config/pipeline.yaml',
        scenarios='data/reference_sensitivity_scenarios.csv',
    output:
        gate=REVIEW_DIR + '/gate_of_record.png',
        diagnostic=REVIEW_DIR + '/convergence_diagnostic.png',
        sampling=REVIEW_DIR + '/a4v_sampling_sensitivity.png',
        redox=REVIEW_DIR + '/g93a_disulfide_diagnostic.png',
        uncertainty=REVIEW_DIR + '/redox_uncertainty.json',
    shell:
        'MPLCONFIGDIR=/tmp/sod1fep-mpl python -m src.analysis.methods_figures '
        '--attempt1-archive {ARCHIVE:q} '
        '--reanalysis-convergence {ARCHIVE:q}/reanalysis_2026-09-12/convergence '
        '--ss-archive {SS_ARCHIVE:q} --output-dir {REVIEW_DIR:q}'

rule forensic_reference_reproduction:
    input:
        records=expand(ARCHIVE + '/fep/{variant}/ddg.json', variant=[v for v in GATE_SUBSET if v != 'A4V']),
        a4v=ARCHIVE + '/archive/A4V_3ns_ddg.json',
        scenarios='data/reference_sensitivity_scenarios.csv',
        code='scripts/reproduce_reference_sensitivity_independent.py',
    output:
        report=REVIEW_DIR + '/reference_reproduction.json',
        figure=REVIEW_DIR + '/reference_sensitivity.png',
    shell:
        'MPLCONFIGDIR=/tmp/sod1fep-mpl python scripts/reproduce_reference_sensitivity_independent.py '
        '--archive-root {ARCHIVE:q} --json {output.report:q} --figure {output.figure:q}'

rule forensic_release:
    input:
        audit=rules.forensic_diagnostic_audit.output,
        figures=rules.forensic_methods_figures.output,
        reference=rules.forensic_reference_reproduction.output,
        manifest='data/forensic_archive_manifest.json',
        historical=HISTORICAL_INPUTS,
        sources=[str(p) for folder in ('src', 'tests', 'config', 'docs', 'env', 'scripts', 'workflow', 'data')
                 for p in Path(folder).rglob('*') if p.is_file()
                 and '__pycache__' not in p.parts and p.name != '.DS_Store'
                 and 'data/structures' not in str(p)
                 and str(p.parent) != REVIEW_DIR and p.suffix not in ('.npz', '.pyc')],
        overview=['README.md', 'HANDOFF.md', 'CLAUDE.md', 'AGENTS.md'],
    output:
        bundle=REVIEW['release_file'],
        checksum=REVIEW['release_file'] + '.sha256',
    shell:
        'python -m src.analysis.forensic_release --archive-root {ARCHIVE:q} '
        '--ss-archive {SS_ARCHIVE:q} --output {output.bundle:q} '
        '&& python -m src.analysis.forensic_release --verify {output.bundle:q}'
